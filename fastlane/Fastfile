# Fastlane for StressMonitor — GitHub Actions + TestFlight CI/CD
#
# Usage:
#   bundle exec fastlane build_widget    — Build widget extension only
#   bundle exec fastlane upload_beta     — Build & upload to TestFlight (no distribution)
#   bundle exec fastlane distribute_beta — Distribute processed build to TestFlight group
#   bundle exec fastlane release         — Submit latest TestFlight build for App Store review
#   bundle exec fastlane build_only      — Build IPA without uploading

default_platform(:ios)

platform :ios do
  # ────────────────────── CONFIG ──────────────────────
  APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "stress.ai.com"
  WATCH_APP_IDENTIFIER = ENV["WATCH_APP_IDENTIFIER"] || "stress.ai.com.watchkitapp"
  WIDGET_APP_IDENTIFIER = ENV["WIDGET_APP_IDENTIFIER"] || "stress.ai.com.widget"
  SCHEME = "StressMonitor"
  PROJECT = "StressMonitor/StressMonitor.xcodeproj"

  def api_key
    @api_key ||= begin
      key_path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "~/.appstoreconnect/AuthKey.p8")
      unless File.exist?(key_path)
        # Write from env var if file doesn't exist (CI)
        if ENV["APP_STORE_CONNECT_API_KEY_P8"]
          dir = File.dirname(key_path)
          FileUtils.mkdir_p(dir)
          File.write(key_path, ENV["APP_STORE_CONNECT_API_KEY_P8"])
        end
      end

      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        filepath: key_path,
        duration: 1200, # 20 min token
        in_house: false
      )
    end
  end

  desc "Build widget extension only (for CI validation)"
  lane :build_widget do
    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      skip_package_ipa: true,
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "CODE_SIGN_IDENTITY=",
        "CODE_SIGNING_REQUIRED=NO"
      ].join(" "),
      suppress_xcode_output: false
    )
  end

  desc "Dump App ID capability state from the ASC API (portal debugging)"
  lane :dump_capabilities do
    require "spaceship"
    key_path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"] || "~/.appstoreconnect/AuthKey.p8")
    unless File.exist?(key_path) && !ENV["APP_STORE_CONNECT_API_KEY_P8"]
      dir = File.dirname(key_path)
      FileUtils.mkdir_p(dir)
      File.write(key_path, ENV["APP_STORE_CONNECT_API_KEY_P8"])
    end
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      filepath: key_path
    )
    ["stress.ai.com", "stress.ai.com.watchkitapp", "stress.ai.com.widget"].each do |bid|
      bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: bid, platform: "IOS" }).first
      UI.message("=== #{bid}: bundle_id=#{bundle ? bundle.id : 'NOT FOUND'}")
      next unless bundle
      Spaceship::ConnectAPI::BundleIdCapability.all(bundle_id_id: bundle.id).each do |cap|
        UI.message("    #{cap.capability_type} settings=#{cap.settings}")
      end
    end
  end

  # ────────────────────── SETUP MATCH ──────────────────────
  desc "One-time local setup: generate certs and profiles into the Match repo"
  lane :setup_match do
    match(
      type: "appstore",
      readonly: false,
      force: true,
      api_key: api_key
    )
  end

  # ────────────────────── BUILD ONLY ──────────────────────
  desc "Build IPA without uploading (for CI validation)"
  lane :build_only do
    setup_ci

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      include_bitcode: false,
      include_symbols: true,
      output_directory: "build/",
      output_name: "StressMonitor.ipa",
      archive_path: "build/StressMonitor.xcarchive",
      skip_package_ipa: false,
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "COMPILER_INDEX_STORE_ENABLE=NO"
      ].join(" "),
      suppress_xcode_output: false
    )
  end

  # ────────────────────── UPLOAD BETA ──────────────────────
  desc "Build and upload to TestFlight (no distribution)"
  lane :upload_beta do
    setup_ci

    # Import Apple WWDR intermediate cert into tmp keychain before match validates
    sh("curl -fsS 'https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer' -o /tmp/AppleWWDRCAG3.cer 2>/dev/null; security import /tmp/AppleWWDRCAG3.cer -k ~/Library/Keychains/fastlane_tmp_keychain-db 2>/dev/null || true")

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    {
      "StressMonitor"              => "match AppStore #{APP_IDENTIFIER}",
      "StressMonitorWatch Watch App" => "match AppStore #{WATCH_APP_IDENTIFIER}",
      "StressMonitorWidgetExtension" => "match AppStore #{WIDGET_APP_IDENTIFIER}"
    }.each do |target, profile_name|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: PROJECT,
        team_id: "K2TYLYAWMK",
        code_sign_identity: "iPhone Distribution",
        targets: target,
        profile_name: profile_name
      )
    end

    increment_build

    # Capture changelog at build time (accurate: reflects commits in this build)
    notes = begin
      changelog_from_git_commits(
        merge_commit_filtering: "exclude_merges",
        commits_count: 20,
        pretty: "- %s"
      )
    rescue => e
      UI.important("Could not generate changelog: #{e.message}")
      "Build from #{ENV['GITHUB_SHA']&.[](0..6) || 'local'}"
    end
    FileUtils.mkdir_p("build")
    File.write("build/CHANGELOG.txt", notes)

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      include_bitcode: false,
      include_symbols: true,
      output_directory: "build/",
      output_name: "StressMonitor.ipa",
      archive_path: "build/StressMonitor.xcarchive",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "COMPILER_INDEX_STORE_ENABLE=NO"
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}",
          WATCH_APP_IDENTIFIER => "match AppStore #{WATCH_APP_IDENTIFIER}",
          WIDGET_APP_IDENTIFIER => "match AppStore #{WIDGET_APP_IDENTIFIER}"
        }
      },
      suppress_xcode_output: false
    )

    pilot(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )

    slack_notify("uploaded to TestFlight (processing)")
  end

  # ────────────────────── DISTRIBUTE BETA ──────────────────────
  desc "Distribute a processed build to a TestFlight group"
  lane :distribute_beta do
    groups = (ENV["TESTFLIGHT_GROUPS"] || "Core Testers").split(",").map(&:strip)

    # Read changelog written during upload_beta (accurate, build-time snapshot)
    notes = if File.exist?("build/CHANGELOG.txt")
      File.read("build/CHANGELOG.txt")
    else
      "Build from #{ENV['GITHUB_SHA']&.[](0..6) || 'local'}"
    end

    # pilot auto-selects latest processed build when distribute_only: true
    pilot(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_only: true,
      groups: groups,
      notify_external_testers: true,
      changelog: notes
    )

    slack_notify("distributed to #{groups.join(', ')}")
  end

  # ────────────────────── APP STORE RELEASE ──────────────────────
  desc "Upload metadata/screenshots to ASC (manual submission)"
  lane :release do
    setup_ci

    latest_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key
    )

    UI.message("Uploading metadata for TestFlight build ##{latest_build} — submit manually in ASC")

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      build_number: latest_build.to_s,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      precheck_include_in_app_purchases: false
    )

    slack_notify("metadata uploaded to ASC (build ##{latest_build}) — submit manually")
  end

  # ────────────────────── INCREMENT BUILD NUMBER ──────────────────────
  desc "Auto-increment build number based on latest TestFlight build"
  lane :increment_build do
    # Get latest build number from TestFlight
    latest_tf = begin
      latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key: api_key
      )
    rescue => e
      UI.important("Could not fetch latest TestFlight build number: #{e.message}")
      0
    end

    # Get current App Store build number (if app is live)
    current_version = get_version_number(
      xcodeproj: PROJECT,
      target: "StressMonitor"
    )

    latest_store = begin
      app_store_build_number(
        app_identifier: APP_IDENTIFIER,
        version: current_version,
        api_key: api_key
      )
    rescue => e
      UI.important("Could not fetch latest App Store build number: #{e.message}")
      0
    end

    new_build = [latest_tf, latest_store].max + 1

    UI.message("Setting build number to #{new_build} (TF: #{latest_tf}, Store: #{latest_store})")

    increment_build_number(
      build_number: new_build.to_s,
      xcodeproj: PROJECT
    )
  end

  # ────────────────────── HELPERS ──────────────────────
  def slack_notify(action = "deployed")
    return unless ENV["SLACK_WEBHOOK_URL"]

    version = get_version_number(xcodeproj: PROJECT, target: "StressMonitor")
    build   = get_build_number(xcodeproj: PROJECT)

    slack(
      slack_url: ENV["SLACK_WEBHOOK_URL"],
      message: "📦 *StressMonitor #{version} (#{build})* #{action}",
      payload: {
        "Build"   => build,
        "Version" => version,
        "Commit"  => ENV["GITHUB_SHA"]&.[](0..6) || "N/A",
        "Run"     => ENV["GITHUB_RUN_ID"] ? "<#{ENV['GITHUB_SERVER_URL']}/#{ENV['GITHUB_REPOSITORY']}/actions/runs/#{ENV['GITHUB_RUN_ID']}|View>" : "local"
      }
    )
  end
end
